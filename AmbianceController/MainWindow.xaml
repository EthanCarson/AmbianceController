<Window x:Class="AmbianceController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambiance Controller" 
        Height="350" Width="500"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Border CornerRadius="15" 
            Background="#11FFFFFF" 
            BorderBrush="#44FFFFFF" 
            BorderThickness="1.5">

        <Grid>
            <Button Content="—" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0,10,45,0" 
                    Width="30" Height="30"
                    Background="#00FFFFFF" 
                    Foreground="White" 
                    FontSize="16"
                    FontWeight="Bold"
                    BorderBrush="#00FFFFFF"
                    Cursor="Hand"
                    Click="MinimizeButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="X" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="10" 
                    Width="30" Height="30"
                    Background="#00FF0000" 
                    Foreground="White" 
                    FontSize="20"
                    FontWeight="Bold"
                    BorderBrush="#00FFFFFF"
                    Cursor="Hand"
                    Click="CloseButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>

            <TextBlock Text="Ambiance Controller" 
                       Foreground="White" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="24" 
                       FontWeight="Bold"/>
        </Grid>
    </Border>
</Window>